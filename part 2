<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aventra — India Tours & Quote Calculator</title>
  
  <!-- Google Fonts: Fraunces & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'main-dark': '#0a0d12',
            'card-dark': '#1a1f29',
            'card-inner': '#141820',
            'gold': '#c9a24a',
            'gold-bright': '#e2bd6a',
            'gold-soft': 'rgba(201,162,74,0.14)',
          },
          fontFamily: {
            serif: ['Fraunces', 'serif'],
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  
  <style>
    :root {
      --main-dark: #0a0d12;
      --card-dark: #1a1f29;
      --card-inner: #141820;
      --text-main: #efe7d5;
      --text-dim: #a89f8c;
      --gold: #c9a24a;
      --gold-bright: #e2bd6a;
    }

    body {
      background-color: var(--main-dark);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
    }

    h1, h2, h3, h4, .font-serif {
      font-family: 'Fraunces', serif;
    }

    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0a0d12;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a3342;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #c9a24a;
    }

    .check-input:checked + label {
      border-color: #c9a24a;
      background-color: rgba(201,162,74,0.12);
      color: #e2bd6a;
    }
  </style>
</head>
<body class="selection:bg-gold selection:text-black">

  <!-- ================= HEADER ================= -->
  <nav class="sticky top-0 z-50 flex justify-between items-center px-6 md:px-12 py-4 bg-[#0a0d12]/90 backdrop-blur-md border-b border-[#efe7d5]/10">
    <div class="flex items-center gap-3">
      <div class="w-3 h-3 bg-gold rotate-45"></div>
      <span class="text-xl font-serif font-bold tracking-wider">Aven<span class="text-gold">tra</span></span>
    </div>
    <div class="hidden md:flex items-center gap-8 text-sm text-[#a89f8c]">
      <a href="#quote" class="hover:text-gold transition-colors">Get Quote</a>
      <a href="#destinations" class="hover:text-gold transition-colors">Destinations</a>
      <a href="#reviews" class="hover:text-gold transition-colors">Reviews</a>
      <a href="#contact" class="hover:text-gold transition-colors">Quick Contact</a>
    </div>
  </nav>

  <!-- ================= HERO ================= -->
  <section class="relative min-h-[550px] flex items-center justify-center text-center px-6 py-28 bg-cover bg-center" style="background-image: linear-gradient(rgba(10,13,18,0.65), rgba(10,13,18,0.75)), url('https://images.unsplash.com/photo-1524492412937-b28074a5d7da?auto=format&fit=crop&w=1800&q=85');">
    <div class="max-w-3xl mx-auto z-10">
      <h1 class="text-4xl md:text-6xl font-bold font-serif leading-tight mb-6 text-[#efe7d5]">
        Travel India With <span class="text-gold">Aventra</span>
      </h1>
      <p class="text-lg md:text-xl text-[#a89f8c] font-sans">
        Premium domestic holidays, sacred pilgrimages, and carefully planned journeys across India.
      </p>
    </div>
  </section>

  <!-- ================= QUOTE FORM ================= -->
  <section id="quote" class="py-24 px-6 md:px-12 max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold font-serif mb-3">Plan Your Journey</h2>
      <p class="text-[#a89f8c]">Select your tour preferences and travel details to receive a custom quotation</p>
    </div>

    <div class="bg-card-dark border border-[#efe7d5]/10 p-8 md:p-12 rounded-2xl shadow-2xl">
      <form>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Tour Type -->
          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium text-[#efe7d5]">Tour Type</label>
            <select required class="w-full p-4 rounded-xl bg-card-inner border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
              <option value="" class="bg-[#141820]">Select Tour Type</option>
              <option class="bg-[#141820]">Domestic Tour</option>
              <option class="bg-[#141820]">Popular India Tour</option>
              <option class="bg-[#141820]">Pilgrimage Tour</option>
              <option class="bg-[#141820]">Temple Tour</option>
              <option class="bg-[#141820]">Char Dham Yatra</option>
              <option class="bg-[#141820]">12 Jyotirlinga Yatra</option>
            </select>
          </div>

          <!-- Destination -->
          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium text-[#efe7d5]">Destination</label>
            <select required class="w-full p-4 rounded-xl bg-card-inner border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
              <option value="" class="bg-[#141820]">Select Destination</option>
              <option class="bg-[#141820] text-[#efe7d5]">Golden Triangle (Delhi - Agra - Jaipur)</option>
              <option class="bg-[#141820] text-[#efe7d5]">Udaipur Palace Tour</option>
              <option class="bg-[#141820] text-[#efe7d5]">Kerala Backwaters & Munnar</option>
              <option class="bg-[#141820] text-[#efe7d5]">Kashmir (Srinagar & Gulmarg)</option>
              <option class="bg-[#141820] text-[#efe7d5]">Goa Beaches & Heritage</option>
              <option class="bg-[#141820] text-[#efe7d5]">Varanasi & Ayodhya Darshan</option>
              <option class="bg-[#141820] text-[#efe7d5]">Leh Ladakh Adventure</option>
              <option class="bg-[#141820] text-[#efe7d5]">Char Dham Yatra</option>
            </select>
          </div>

          <!-- Travel Date -->
          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium text-[#efe7d5]">Travel Date</label>
            <input type="date" required class="w-full p-4 rounded-xl bg-card-inner border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
          </div>

          <!-- Travellers -->
          <div class="flex flex-col gap-2">
            <label class="text-sm font-medium text-[#efe7d5]">Number of Travellers</label>
            <input type="number" min="1" placeholder="e.g. 2" required class="w-full p-4 rounded-xl bg-card-inner border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
          </div>

          <!-- Additional Services -->
          <div class="col-span-full flex flex-col gap-2 mt-4">
            <label class="text-sm font-medium text-[#efe7d5]">Additional Services</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              <div class="relative"><input type="checkbox" id="srv1" class="check-input sr-only"><label for="srv1" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Home Pickup</label></div>
              <div class="relative"><input type="checkbox" id="srv2" class="check-input sr-only"><label for="srv2" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Home Drop</label></div>
              <div class="relative"><input type="checkbox" id="srv3" class="check-input sr-only"><label for="srv3" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Food Preference</label></div>
              <div class="relative"><input type="checkbox" id="srv4" class="check-input sr-only"><label for="srv4" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Hotel Upgrade</label></div>
              <div class="relative"><input type="checkbox" id="srv5" class="check-input sr-only"><label for="srv5" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Private Cab</label></div>
              <div class="relative"><input type="checkbox" id="srv6" class="check-input sr-only"><label for="srv6" class="flex items-center p-3.5 bg-card-inner border border-[#efe7d5]/10 rounded-xl cursor-pointer text-sm font-medium hover:border-gold/50 transition-all">Darshan Assistance</label></div>
            </div>
          </div>

        </div>

        <button type="submit" class="w-full mt-8 py-4 rounded-xl bg-gold hover:bg-gold-bright text-main-dark font-bold text-base transition-all shadow-lg hover:shadow-gold/20">
          Calculate Estimated Quote
        </button>
      </form>
    </div>
  </section>

  <!-- ================= DISCOVER MORE PLACES (8 DIVS WITH PHOTOS) ================= -->
  <section id="destinations" class="py-24 bg-card-dark border-y border-[#efe7d5]/10 px-6 md:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold font-serif mb-3">Explore Incredible Destinations</h2>
        <p class="text-[#a89f8c]">Browse through our curated collection of iconic landmarks and hidden gems across India</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Place 1 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1564507592333-c60657eea523?auto=format&fit=crop&w=800&q=80" alt="Agra" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Agra (Taj Mahal)</h3>
            <p class="text-xs text-[#a89f8c]">Witness the timeless symbol of love and grand Mughal architecture.</p>
          </div>
        </div>

        <!-- Place 2 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=800&q=80" alt="Jaipur" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Jaipur (Pink City)</h3>
            <p class="text-xs text-[#a89f8c]">Explore majestic forts, royal palaces, and vibrant cultural streets.</p>
          </div>
        </div>

        <!-- Place 3: Udaipur (Newly Replaced Unsplash Link) -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=800&q=80" alt="Udaipur" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Udaipur</h3>
            <p class="text-xs text-[#a89f8c]">Enjoy peaceful boat rides on Lake Pichola and historic lakeside palaces.</p>
          </div>
        </div>

        <!-- Place 4 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=800&q=80" alt="Kerala" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Kerala Backwaters</h3>
            <p class="text-xs text-[#a89f8c]">Relax in traditional houseboats surrounded by tranquil palm-fringed waters.</p>
          </div>
        </div>

        <!-- Place 5 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1595815771614-ade9d652a65d?auto=format&fit=crop&w=800&q=80" alt="Kashmir" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Kashmir Valley</h3>
            <p class="text-xs text-[#a89f8c]">Experience breathtaking snow mountains and iconic Dal Lake shikaras.</p>
          </div>
        </div>

        <!-- Place 6 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=800&q=80" alt="Goa" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Goa Beaches</h3>
            <p class="text-xs text-[#a89f8c]">Unwind on golden sands, enjoy coastal cuisine and Portuguese heritage.</p>
          </div>
        </div>

        <!-- Place 7 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1571536802807-30451e3955d8?auto=format&fit=crop&w=800&q=80" alt="Varanasi" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Varanasi Ghats</h3>
            <p class="text-xs text-[#a89f8c]">Witness spiritual Ganga Aarti and ancient heritage along the holy river.</p>
          </div>
        </div>

        <!-- Place 8 -->
        <div class="bg-card-inner border border-[#efe7d5]/10 rounded-2xl overflow-hidden hover:-translate-y-1.5 transition-all duration-300 shadow-md">
          <img src="https://images.unsplash.com/photo-1544735716-392fe2489ffa?auto=format&fit=crop&w=800&q=80" alt="Leh Ladakh" class="w-full h-52 object-cover">
          <div class="p-6">
            <h3 class="text-xl font-serif text-gold mb-1">Leh Ladakh</h3>
            <p class="text-xs text-[#a89f8c]">Embark on an adventure across high-altitude blue lakes and mountain passes.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= CUSTOMER REVIEWS ================= -->
  <section id="reviews" class="py-24 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold font-serif mb-3">What Our Travelers Say</h2>
      <p class="text-[#a89f8c]">Real experiences from guests who explored India with Aventra</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Review 1 -->
      <div class="bg-card-dark border border-[#efe7d5]/10 p-8 rounded-2xl flex flex-col justify-between">
        <p class="text-sm text-[#efe7d5]/90 italic mb-6">"Our Golden Triangle tour was managed impeccably. The private cab, expert guide, and hotel selections made our family vacation completely stress-free!"</p>
        <div class="flex items-center gap-4 border-t border-[#efe7d5]/10 pt-4">
          <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center font-serif text-gold font-bold">R</div>
          <div>
            <h4 class="text-sm font-semibold text-[#efe7d5]">Rajesh Sharma</h4>
            <span class="text-xs text-[#a89f8c]">Delhi — Golden Triangle Tour</span>
          </div>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="bg-card-dark border border-[#efe7d5]/10 p-8 rounded-2xl flex flex-col justify-between">
        <p class="text-sm text-[#efe7d5]/90 italic mb-6">"The Kerala backwaters itinerary was absolute magic. From the houseboat stay to the prompt airport transfers, everything was top-notch."</p>
        <div class="flex items-center gap-4 border-t border-[#efe7d5]/10 pt-4">
          <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center font-serif text-gold font-bold">A</div>
          <div>
            <h4 class="text-sm font-semibold text-[#efe7d5]">Ananya Iyer</h4>
            <span class="text-xs text-[#a89f8c]">Bengaluru — Kerala Holiday</span>
          </div>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="bg-card-dark border border-[#efe7d5]/10 p-8 rounded-2xl flex flex-col justify-between">
        <p class="text-sm text-[#efe7d5]/90 italic mb-6">"Their darshan assistance in Varanasi was incredible. We didn't have to worry about queues or logistics at all. Highly professional team!"</p>
        <div class="flex items-center gap-4 border-t border-[#efe7d5]/10 pt-4">
          <div class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center font-serif text-gold font-bold">V</div>
          <div>
            <h4 class="text-sm font-semibold text-[#efe7d5]">Vikram Malhotra</h4>
            <span class="text-xs text-[#a89f8c]">Mumbai — Pilgrimage Tour</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= LAST SECTION: NAME, NUMBER, EMAIL CONTACT FORM ================= -->
  <section id="contact" class="py-24 bg-card-dark border-t border-[#efe7d5]/10 px-6 md:px-12">
    <div class="max-w-3xl mx-auto bg-[#141820] border border-[#efe7d5]/15 p-8 md:p-12 rounded-2xl shadow-2xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold font-serif mb-2">Get In Touch Directly</h2>
        <p class="text-[#a89f8c] text-sm">Leave your details and our travel consultant will call you back shortly</p>
      </div>

      <form class="space-y-6">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-[#efe7d5]">Your Full Name</label>
          <input type="text" placeholder="Enter your full name" required class="w-full p-4 rounded-xl bg-card-dark border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-[#efe7d5]">Phone / WhatsApp Number</label>
          <input type="tel" placeholder="+91 98765 43210" required class="w-full p-4 rounded-xl bg-card-dark border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-[#efe7d5]">Email Address</label>
          <input type="email" placeholder="name@example.com" required class="w-full p-4 rounded-xl bg-card-dark border border-[#efe7d5]/15 text-[#efe7d5] focus:border-gold focus:outline-none">
        </div>

        <button type="submit" class="w-full py-4 rounded-xl bg-gold hover:bg-gold-bright text-main-dark font-bold text-base transition-all shadow-lg hover:shadow-gold/20">
          Submit Contact Details
        </button>
      </form>
    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="py-12 bg-[#06080c] border-t border-[#efe7d5]/10 text-center text-sm text-[#a89f8c]">
    <p>
      <strong class="text-gold font-serif">Aventra</strong> — Premium journeys across India.
    </p>
  </footer>

</body>
</html>
