<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aventra Travels | Smart & Vibrant Group Trips</title>

<!-- Google Fonts: Fraunces & Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --bg-dark: #0a0d12;
    --bg-card: #1a1f29;
    --bg-card-hover: #222834;
    --bg-card-inner: #141820;
    --primary: #c9a24a;
    --primary-bright: #e2bd6a;
    --primary-soft: rgba(201, 162, 74, 0.14);
    --accent: #c9a24a;
    --text-main: #efe7d5;
    --text-sub: #a89f8c;
    --border: rgba(239, 231, 213, 0.1);
    --gold: #c9a24a;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    overflow-x: hidden;
}

h1, h2, h3, h4, .logo {
    font-family: 'Fraunces', serif;
}

::selection {
    background-color: var(--gold);
    color: #0a0d12;
}

/* CUSTOM SCROLLBAR */
::-webkit-scrollbar {
    width: 8px;
}
::-webkit-scrollbar-track {
    background: var(--bg-dark);
}
::-webkit-scrollbar-thumb {
    background: #2a3342;
    border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
    background: var(--gold);
}

/* NAVIGATION */
nav {
    position: sticky;
    top: 0;
    width: 100%;
    padding: 18px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10, 13, 18, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    z-index: 1000;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: 1px;
}

.logo span {
    color: var(--gold);
}

.nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
}

.nav-links a {
    color: var(--text-sub);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
}

.nav-links a:hover {
    color: var(--gold);
}

/* HERO */
.hero {
    text-align: center;
    padding: 110px 20px 70px 20px;
    max-width: 900px;
    margin: 0 auto;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: var(--primary-soft);
    border: 1px solid rgba(201, 162, 74, 0.3);
    color: var(--primary-bright);
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(36px, 5vw, 62px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
    color: var(--text-main);
}

.hero h1 span {
    background: linear-gradient(135deg, var(--gold-bright) 0%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero p {
    font-size: 17px;
    color: var(--text-sub);
    margin: 0 auto 35px auto;
    max-width: 600px;
}

.btn-primary {
    display: inline-block;
    background: var(--gold);
    color: #0a0d12;
    padding: 14px 32px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(201, 162, 74, 0.2);
}

.btn-primary:hover {
    background: var(--primary-bright);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(201, 162, 74, 0.3);
}

/* TRUST & PARTNERS SECTION */
.partners-section {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 45px 6%;
    text-align: center;
}

.partners-header {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-sub);
    margin-bottom: 25px;
}

.iso-container {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--primary-soft);
    border: 1px solid rgba(201, 162, 74, 0.3);
    padding: 8px 20px;
    border-radius: 50px;
    margin-bottom: 35px;
}

.iso-badge {
    font-size: 12px;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 1px;
}

.partners-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px 30px;
    max-width: 1100px;
    margin: 0 auto;
}

.partner-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    padding: 12px 22px;
    border-radius: 12px;
    transition: all 0.2s ease;
}

.partner-card:hover {
    border-color: rgba(201, 162, 74, 0.4);
    transform: translateY(-2px);
}

.partner-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
}

.partner-tag {
    font-size: 11px;
    color: var(--gold);
    background: var(--primary-soft);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 4px;
}

/* SECTIONS */
section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;
    font-size: 34px;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--text-main);
}

.section-subtitle {
    text-align: center;
    color: var(--text-sub);
    font-size: 15px;
    margin-bottom: 45px;
}

/* SERVICES GRID */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.25s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: rgba(201, 162, 74, 0.4);
    background: var(--bg-card-hover);
}

.card-img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.card-content {
    padding: 22px;
}

.card h3 {
    font-size: 19px;
    margin-bottom: 8px;
    color: var(--gold);
}

.card p {
    color: var(--text-sub);
    font-size: 14px;
}

/* HOW IT WORKS */
.steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
}

.step-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 30px 22px;
    border-radius: 16px;
    text-align: center;
}

.step-number {
    width: 48px;
    height: 48px;
    background: var(--primary-soft);
    color: var(--gold);
    font-weight: 800;
    font-size: 18px;
    border-radius: 12px;
    border: 1px solid rgba(201, 162, 74, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px auto;
}

.step-box h4 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--text-main);
}

.step-box p {
    color: var(--text-sub);
    font-size: 14px;
}

/* LOCATIONS */
.locations-container {
    max-width: 1000px;
    margin: 0 auto;
}

.search-box {
    margin-bottom: 20px;
    text-align: center;
}

.search-input {
    width: 100%;
    max-width: 500px;
    padding: 14px 20px;
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-main);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
}

.search-input:focus {
    border-color: var(--gold);
}

.filter-buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.filter-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-sub);
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
}

.filter-btn.active,
.filter-btn:hover {
    background: var(--gold);
    color: #0a0d12;
    border-color: var(--gold);
}

.locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    max-height: 450px;
    overflow-y: auto;
    padding-right: 5px;
}

.locations-grid::-webkit-scrollbar {
    width: 5px;
}
.locations-grid::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
}

.loc-badge {
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.2s ease;
    cursor: pointer;
}

.loc-badge:hover {
    border-color: var(--gold);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
}

.loc-badge .tag {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--gold);
}

/* REVIEWS & FAQ */
.reviews-grid, .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.review-card, .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 24px;
    border-radius: 16px;
}

.review-card p, .faq-item p {
    color: var(--text-sub);
    font-size: 14px;
    font-style: italic;
}

.reviewer-name {
    font-weight: 700;
    font-size: 14px;
    margin-top: 15px;
    color: var(--gold);
    font-style: normal;
}

.faq-item h4 {
    font-size: 16px;
    margin-bottom: 8px;
    color: var(--text-main);
}

/* CONTACT */
.contact-form {
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
    background: var(--bg-card);
    padding: 35px;
    border-radius: 20px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.contact-form input,
.contact-form select,
.contact-form textarea {
    width: 100%;
    padding: 14px;
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-main);
    font-size: 14px;
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s ease;
}

.contact-form select option {
    background: var(--bg-card-inner);
    color: var(--text-main);
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
    border-color: var(--gold);
}

footer {
    text-align: center;
    padding: 30px;
    border-top: 1px solid var(--border);
    background: #06080c;
    color: var(--text-sub);
    font-size: 13px;
}

footer strong {
    color: var(--gold);
}

@media (max-width: 768px) {
    .nav-links { display: none; }
    section { padding: 50px 5%; }
}
</style>
</head>

