    // Render Destinations Grid in Portfolio Section
    function renderDestinations(filter = 'all') {
      const container = document.getElementById('destinationsGrid');
      container.innerHTML = '';
      
      const filtered = filter === 'all' ? destinations : destinations.filter(d => d.region === filter);
      
      filtered.forEach(dest => {
        const card = document.createElement('div');
        card.className = 'bg-card-dark border border-white/10 rounded-2xl overflow-hidden hover:border-gold/50 transition-all duration-300 group';
        card.innerHTML = `
          <div class="h-48 overflow-hidden relative">
            <img src="${dest.img}" alt="${dest.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            <span class="absolute top-3 right-3 bg-black/70 backdrop-blur-md text-gold text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">${dest.region}</span>
          </div>
          <div class="p-5">
            <h3 class="font-serif font-bold text-base mb-1 text-white">${dest.name}</h3>
            <div class="flex justify-between items-center mt-3">
              <span class="text-xs text-[#a89f8c]">From <strong class="text-gold">₹${dest.price.toLocaleString('en-IN')}</strong></span>
              <a href="#calculator" onclick="selectDestinationInCalc('${dest.name}')" class="text-xs font-bold text-gold hover:underline">Book Journey →</a>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Render Calculator Destination Selector Radios
    function renderCalculatorDestinations() {
      const grid = document.getElementById('calcDestGrid');
      grid.innerHTML = '';
      
      destinations.forEach((dest, idx) => {
        const isChecked = idx === 0 ? 'checked' : '';
        const id = `calc_dest_${idx}`;
        const div = document.createElement('div');
        div.innerHTML = `
          <input type="radio" name="calcDestination" id="${id}" value="${dest.name}" data-price="${dest.price}" class="hidden dest-radio" ${isChecked} onchange="calculateTotal()">
          <label for="${id}" class="bg-card-inner border border-white/10 rounded-xl p-3 text-center cursor-pointer block hover:border-white/30 transition-all h-full flex flex-col justify-between">
            <span class="font-serif font-bold text-xs block truncate mb-1">${dest.name}</span>
            <span class="text-[10px] text-gold font-semibold">₹${dest.price.toLocaleString('en-IN')}</span>
          </label>
        `;
        grid.appendChild(div);
      });
    }

    // Filter Button Handler
    function filterDestinations(region) {
      document.querySelectorAll('.region-btn').forEach(btn => {
        if(btn.dataset.region === region) {
          btn.className = 'region-btn px-4 py-2 bg-gold text-black text-xs font-bold rounded-lg transition-all';
        } else {
          btn.className = 'region-btn px-4 py-2 bg-card-dark border border-white/10 text-xs font-semibold rounded-lg hover:border-gold transition-all';
        }
      });
      renderDestinations(region);
    }

    // Select destination in calculator when clicked from portfolio
    function selectDestinationInCalc(destName) {
      const radios = document.querySelectorAll('.dest-radio');
      radios.forEach(r => {
        if(r.value === destName) {
          r.checked = true;
          calculateTotal();
        }
      });
    }

    // Real-time Calculation Engine
    function calculateTotal() {
      const selectedDestRadio = document.querySelector('.dest-radio:checked');
      const basePrice = selectedDestRadio ? parseFloat(selectedDestRadio.dataset.price) : 75000;
      const destName = selectedDestRadio ? selectedDestRadio.value : 'Paris, France';

      const travelers = Math.max(1, parseInt(document.getElementById('travelersCount').value) || 1);

      const selectedHotelRadio = document.querySelector('.option-radio:checked');
      const hotelMult = selectedHotelRadio ? parseFloat(selectedHotelRadio.dataset.mult) : 1.0;
      const hotelName = selectedHotelRadio ? selectedHotelRadio.dataset.name : '3-Star Standard';

      // Checkbox perks sum
      let perksSum = 0;
      let perksDescList = [];

      const chauffeur = document.getElementById('addon_chauffeur');
      if(chauffeur.checked) {
        perksSum += parseFloat(chauffeur.dataset.price);
        perksDescList.push('Home Chauffeur');
      }

      const flights = document.getElementById('addon_flights');
      if(flights.checked) {
        perksSum += parseFloat(flights.dataset.price);
        perksDescList.push('Flights');
      }

      const visa = document.getElementById('addon_visa');
      if(visa.checked) {
        perksSum += parseFloat(visa.dataset.price);
        perksDescList.push('Visa Support');
      }

      const butler = document.getElementById('addon_butler');
      if(butler.checked) {
        perksSum += parseFloat(butler.dataset.price);
        perksDescList.push('Private Butler');
      }

      // Formula: (Base * HotelMultiplier + AddonsPerPerson) * Travelers
      const total = (basePrice * hotelMult + perksSum) * travelers;

      // Update Summary DOM
      document.getElementById('sumDestText').textContent = destName;
      document.getElementById('sumHotelText').textContent = hotelName;
      document.getElementById('sumPerksText').textContent = `${travelers} Traveler(s) + ${perksDescList.join(', ') || 'Standard'}`;
      document.getElementById('totalPrice').textContent = '₹' + total.toLocaleString('en-IN');
      document.getElementById('submitBtnText').textContent = `Confirm & Reserve ${destName.split(',')[0]}`;
    }

    // Modal Submission Handlers
    function submitBooking() {
      const destName = document.querySelector('.dest-radio:checked')?.value || 'International Destination';
      const total = document.getElementById('totalPrice').textContent;
      
       document.getElementById('modalDesc').textContent = `Your custom quotation of ${total} for ${destName} has been transmitted securely to your dedicated Aventra Concierge. We will contact you within 2 hours.`;
      document.getElementById('modalOverlay').classList.remove('hidden');
      document.getElementById('modalOverlay').classList.add('flex');
    }

    function showSuccessModal(title, desc) {
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalDesc').textContent = desc;
      document.getElementById('modalOverlay').classList.remove('hidden');
      document.getElementById('modalOverlay').classList.add('flex');
    }

    function closeModal() {
      document.getElementById('modalOverlay').classList.remove('flex');
      document.getElementById('modalOverlay').classList.add('hidden');
    }

    // Initialize on load
    window.addEventListener('DOMContentLoaded', () => {
      // Set default date to 1 month from now
      const nextMonth = new Date();
      nextMonth.setMonth(nextMonth.getMonth() + 1);
      document.getElementById('depDate').valueAsDate = nextMonth;

      renderDestinations('all');
      renderCalculatorDestinations();
      calculateTotal();
    });
